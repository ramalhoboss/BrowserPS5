+// BrowserPS5 (2026-11-11, poc/webkit/ipc-transport/Connection.cpp.patch): the
+// last sync messages of this process, each with the time (ms, the monotonic
+// clock: the same in every process), for a wait that does not end. A page's
+// thread waited up to minutes for the reply to BlobSize while the
+// NetworkProcess, which had handled it, sat idle (docs/28). A sync message
+// that has no reply after two seconds says so and prints these;
+// crash-report.c prints them at BROWSERPS5_STACK_DUMPS's seconds too.
+//   S  a sync message is to be sent (its sync id)    O  it, or a reply, goes to the socket
+//   B  nothing goes out: an earlier message is still waiting for the socket
+//   I  a sync message came in (the connection's thread)    D  it is being handled
+//   A  its reply is to be sent    R  a reply came in    W  the wait for a reply is over
+//   Q  a sync reply was put in the queue of what goes out: twice the queue's length then, plus one if
+//      the send was asked for (it is only when the queue was empty). From then until it goes out (O),
+//      that connection's send loop: E it starts, X it ends (1 not connected, 2 nothing left, 3 a send
+//      failed: 1000 + errno).
+WTF_ALLOW_UNSAFE_BUFFER_USAGE_BEGIN
+struct BrowserPS5IPCNote {
+    double ms;
+    char what;
+    uint16_t name;
+    uint64_t id;
+};
+static BrowserPS5IPCNote browserps5IPCNotes[128];
+static std::atomic<unsigned> browserps5IPCNoteCount { 0 };
+
+static std::atomic<const void*> browserps5Watched { nullptr };
+
+static void browserps5IPCNote(char what, MessageName name, uint64_t id)
+{
+    unsigned n = browserps5IPCNoteCount.fetch_add(1, std::memory_order_relaxed) % 128;
+    browserps5IPCNotes[n] = { MonotonicTime::now().secondsSinceEpoch().milliseconds(), what, static_cast<uint16_t>(name), id };
+}
+
+extern "C" void browserps5_ipc_notes(void);
+extern "C" void browserps5_ipc_notes(void)
+{
+    unsigned count = browserps5IPCNoteCount.load(std::memory_order_relaxed);
+    unsigned first = count > 128 ? count - 128 : 0;
+    fprintf(stderr, "[WebKit] IPC notes of pid %d at %.0f ms, %u so far:\n", static_cast<int>(getpid()), MonotonicTime::now().secondsSinceEpoch().milliseconds(), count);
+    for (unsigned i = first; i < count; i++) {
+        auto& note = browserps5IPCNotes[i % 128];
+        fprintf(stderr, "[WebKit] IPC %c %.0f %s %llu\n", note.what, note.ms, description(static_cast<MessageName>(note.name)).characters(), static_cast<unsigned long long>(note.id));
+    }
+}
+WTF_ALLOW_UNSAFE_BUFFER_USAGE_END
