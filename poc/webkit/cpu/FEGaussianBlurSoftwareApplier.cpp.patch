+    const IntSize loggedSize = paintSize;
+#endif
     applyPlatform(*destinationPixelBuffer, *tempBuffer, kernelSize.width(), kernelSize.height(), paintSize, result.isAlphaImage(), m_effect->edgeMode());
+#if PLATFORM(PLAYSTATION)
+    if (log)
+        browserps5BlurLog(loggedSize, stdDeviation, kernelSize, (MonotonicTime::now() - start).milliseconds());
+#endif
     return true;
 }
 
