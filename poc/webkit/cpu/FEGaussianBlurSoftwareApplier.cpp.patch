@@ -44,10 +44,50 @@
 #include <wtf/ParallelJobs.h>
 #endif
 
+#if PLATFORM(PLAYSTATION)
+#include <stdlib.h>
+#include <wtf/MonotonicTime.h>
+#endif
+
 namespace WebCore {
 
 WTF_MAKE_TZONE_ALLOCATED_IMPL(FEGaussianBlurSoftwareApplier);
 
+#if PLATFORM(PLAYSTATION)
+// BrowserPS5: with BROWSERPS5_FILTER_LOG=1 (env.txt), once a second, how many
+// blurs were computed in software (CSS, SVG or canvas filters), their time,
+// and the size and radius of the last one (see RenderLayerFilters.cpp).
+static bool browserps5BlurLogOn()
+{
+    static const bool on = [] {
+        const char* value = getenv("BROWSERPS5_FILTER_LOG");
+        return value && *value && *value != '0';
+    }();
+    return on;
+}
+
+static void browserps5BlurLog(IntSize paintSize, FloatSize stdDeviation, IntSize kernelSize, double ms)
+{
+    static MonotonicTime windowStart = MonotonicTime::now();
+    static unsigned count;
+    static double totalMs;
+    static double longestMs;
+
+    count++;
+    totalMs += ms;
+    longestMs = std::max(longestMs, ms);
+    auto now = MonotonicTime::now();
+    if (now - windowStart < 1_s)
+        return;
+    WTFLogAlways("BrowserPS5: %u blur(s) in software in %.0f ms, taking %.1f ms (%.1f ms the longest); the last %dx%d, deviation %.1fx%.1f, kernel %dx%d",
+        count, (now - windowStart).milliseconds(), totalMs, longestMs, paintSize.width(), paintSize.height(),
+        stdDeviation.width(), stdDeviation.height(), kernelSize.width(), kernelSize.height());
+    windowStart = now;
+    count = 0;
+    totalMs = longestMs = 0;
+}
+#endif
+
 inline void FEGaussianBlurSoftwareApplier::kernelPosition(int blurIteration, unsigned& radius, int& deltaLeft, int& deltaRight)
 {
