+// BrowserPS5 RN (2026-11-11): BROWSERPS5_PAINT_STATS=1 (web-env.txt, env.txt)
+// writes once a second what the page thread painted into the layers' tiles:
+// how many tiles were made, and for the layers that took the most pixels
+// their name, the tiles painted and the pixels. A scroll of Wikipedia's
+// article ran at 29 frames a second with the page thread painting in every
+// stack, against 59 with the side columns and the headers not shown.
+static void browserPS5PaintStats(const String& layerName, unsigned tilesPainted, uint64_t pixels, unsigned tilesCreated)
+{
+    static const bool enabled = [] {
+        const char* value = getenv("BROWSERPS5_PAINT_STATS");
+        return value && *value == '1';
+    }();
+    if (!enabled)
+        return;
+
+    struct Entry {
+        unsigned updates { 0 };
+        unsigned tiles { 0 };
+        uint64_t pixels { 0 };
+    };
+    static NeverDestroyed<HashMap<String, Entry>> byLayer;
+    static unsigned created;
+    static MonotonicTime last = MonotonicTime::now();
+
+    created += tilesCreated;
+    if (tilesPainted) {
+        auto& entry = byLayer.get().add(layerName.isEmpty() ? String("(no name)"_s) : layerName, Entry { }).iterator->value;
+        entry.updates++;
+        entry.tiles += tilesPainted;
+        entry.pixels += pixels;
+    }
+    auto now = MonotonicTime::now();
+    if (now - last < 1_s)
+        return;
+    last = now;
+
+    Vector<std::pair<String, Entry>> entries;
+    uint64_t total = 0;
+    for (auto& item : byLayer.get()) {
+        entries.append({ item.key, item.value });
+        total += item.value.pixels;
+    }
+    std::ranges::sort(entries, [](auto& a, auto& b) { return a.second.pixels > b.second.pixels; });
+    StringBuilder text;
+    for (size_t i = 0; i < entries.size() && i < 6; ++i)
+        text.append(" | "_s, entries[i].first.left(48), ": "_s, entries[i].second.updates, " updates, "_s, entries[i].second.tiles, " tiles, "_s, entries[i].second.pixels / 1000, " kpx"_s);
+    WTFLogAlways("BrowserPS5 paint: %u tiles made, %zu layers painted, %llu kpx in all%s", created, entries.size(), static_cast<unsigned long long>(total / 1000), text.toString().utf8().data());
+    byLayer.get().clear();
+    created = 0;
+}
+#endif
