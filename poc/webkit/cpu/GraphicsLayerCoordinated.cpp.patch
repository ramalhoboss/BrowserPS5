+#if PLATFORM(PLAYSTATION)
+// BrowserPS5 RN (2026-11-11): BROWSERPS5_PAINT_STATS=1, who asks for a big
+// layer to be painted again whole: its name and the page thread's stack
+// (crash-report.c), a few times a run.
+extern "C" void browserps5_dump_thread(pthread_t) __attribute__((weak));
+
+static void browserPS5NoteBigRepaint(const GraphicsLayerCoordinated& layer, const char* how, const FloatRect& rect)
+{
+    static const bool enabled = [] {
+        const char* value = getenv("BROWSERPS5_PAINT_STATS");
+        return value && *value == '1';
+    }();
+    if (!enabled || rect.width() * rect.height() < 1000000)
+        return;
+    static unsigned calls;
+    static unsigned dumps;
+    ++calls;
+    if (calls % 40 != 20 || dumps >= 12)
+        return;
+    ++dumps;
+    WTFLogAlways("BrowserPS5 paint: %s (call %u) on %s, %.0fx%.0f at %.0f,%.0f of %.0fx%.0f", how, calls, layer.name().utf8().data(), rect.width(), rect.height(), rect.x(), rect.y(), layer.size().width(), layer.size().height());
+    if (browserps5_dump_thread)
+        browserps5_dump_thread(pthread_self());
+}
+#endif
+
