 namespace WTF {
 
+// BrowserPS5 (docs/04-jit.md): JavaScriptCore's JIT pool. On the PS5 a
+// mapping made executable in one go cannot run code (poc/mem_budget,
+// 2026-11-02): pages are mapped, then made executable with mprotect().
+// Doing that page by page as the JIT needs them failed in jsc with EPERM
+// after the first pages (J1, 2026-11-04 18:57), while one mprotect() of a
+// whole 16 MiB region works (poc/jit_probe). So the pool is mapped and made
+// executable as a whole when it is reserved, and its pages then stay
+// mapped: commit() and decommit() leave them alone. The pool is
+// read+write+execute (EXECUTABLE_POOL_WRITABLE): switching pages to
+// read+write+execute only while JSC wrote code (MPROTECT_RX_TO_RWX) crashed
+// the WebProcess's JIT threads on YouTube (J2, 2026-11-04 19:27-19:39),
+// and a region that stays read+write+execute runs code that is rewritten
+// in place (poc/jit_probe, 19:45).
+static std::atomic<uintptr_t> s_jitPoolStart;
+static std::atomic<uintptr_t> s_jitPoolEnd;
+
+// A one-page mprotect() to read+execute failed now and then with errno 0
+// (J2): up to three tries, each failure in the log.
+static bool makeExecutable(void* address, size_t bytes, bool writable)
+{
+    for (int i = 0; i < 3; i++) {
+        errno = 0;
+        int result = mprotect(address, bytes, PROT_READ | PROT_EXEC | (writable ? PROT_WRITE : 0));
+        if (!result)
+            return true;
+        dataLogLn("BrowserPS5: making ", bytes >> 10, " KiB at ", RawPointer(address), " executable failed (try ", i + 1, "): ", result, ", errno ", errno);
+    }
+    return false;
+}
+
+static bool isInJITPool(void* address, size_t bytes)
+{
+    uintptr_t start = reinterpret_cast<uintptr_t>(address);
+    return start >= s_jitPoolStart.load() && start + bytes <= s_jitPoolEnd.load();
+}
